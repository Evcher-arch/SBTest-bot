# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Прокси для Telegram, например socks5://user:pass@host:1080 (пусто — напрямую)
TELEGRAM_PROXY=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Адрес API или прокси (пусто — официальный адрес)
OPENAI_BASE_URL=
# Уровень рассуждения модели (minimal, low, medium, high); пусто — не передаётся.
# При medium ответ из нескольких шагов может не уложиться в ANSWER_TIMEOUT_S.
OPENAI_REASONING_EFFORT=low

# --- Подпись токенов сотрудников (любая длинная случайная строка) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# --- Langfuse ---
# Langfuse из docker-compose.langfuse.yml доступен контейнерам через порт хоста
LANGFUSE_HOST=http://host.docker.internal:3000
# Ключи совпадают с LANGFUSE_INIT_* в docker-compose.langfuse.yml; для Langfuse Cloud — свои
LANGFUSE_PUBLIC_KEY=pk-lf-demo-stand
LANGFUSE_SECRET_KEY=sk-lf-demo-stand

# --- Хранилища ---
DATABASE_URL=postgresql+asyncpg://stand:stand@postgres:5432/stand
REDIS_URL=redis://redis:6379/0

# --- Адреса сервисов внутри сети compose ---
ORCHESTRATOR_URL=http://orchestrator:8000
SEARCH_URL=http://search:8010
MCP_URL=http://mcp-systems:8020
RECOMMENDER_URL=http://recommender:8030
MOCK_URL=http://mock-systems:8040
BOT_URL=http://tg-bot:8443
# Адрес заглушки, открываемый из браузера (ссылки в ответах)
MOCK_PUBLIC_URL=http://localhost:8040

# --- Пороги и расписания ---
AGENT_MAX_STEPS=6
TOOL_TIMEOUT_S=8
ANSWER_TIMEOUT_S=18
HISTORY_LIMIT=12
DRAFT_TTL_S=600
INDEX_INTERVAL_S=60
# Порог косинусной близости для векторного поиска: ниже — фрагмент не считается найденным
SEARCH_MIN_SIMILARITY=0.3
STAND_TIMEZONE=Europe/Moscow
